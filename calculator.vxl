eqBtn.tooltip = "Equals"

first = ""
op = ""
fresh = true

seven.on click {
    display.text = appendDigit display.text, "7", fresh
    fresh = false
}

eight.on click {
    display.text = appendDigit display.text, "8", fresh
    fresh = false
}

nine.on click {
    display.text = appendDigit display.text, "9", fresh
    fresh = false
}

four.on click {
    display.text = appendDigit display.text, "4", fresh
    fresh = false
}

five.on click {
    display.text = appendDigit display.text, "5", fresh
    fresh = false
}

six.on click {
    display.text = appendDigit display.text, "6", fresh
    fresh = false
}

one.on click {
    display.text = appendDigit display.text, "1", fresh
    fresh = false
}

two.on click {
    display.text = appendDigit display.text, "2", fresh
    fresh = false
}

three.on click {
    display.text = appendDigit display.text, "3", fresh
    fresh = false
}

zero.on click {
    display.text = appendDigit display.text, "0", fresh
    fresh = false
}

dotBtn.on click {
    display.text = appendDot display.text, fresh
    fresh = false
}

plusBtn.on click {
    if op = "" {
        first = display.text
    } else {
        if fresh = false {
            first = compute first, op, display.text
            display.text = first
        }
    }
    op = "+"
    fresh = true
    expr.text = first + " +"
}

subBtn.on click {
    if op = "" {
        first = display.text
    } else {
        if fresh = false {
            first = compute first, op, display.text
            display.text = first
        }
    }
    op = "-"
    fresh = true
    expr.text = first + " -"
}

mulBtn.on click {
    if op = "" {
        first = display.text
    } else {
        if fresh = false {
            first = compute first, op, display.text
            display.text = first
        }
    }
    op = "*"
    fresh = true
    expr.text = first + " *"
}

divBtn.on click {
    if op = "" {
        first = display.text
    } else {
        if fresh = false {
            first = compute first, op, display.text
            display.text = first
        }
    }
    op = "/"
    fresh = true
    expr.text = first + " /"
}

eqBtn.on click {
    if op = "" {
        op = ""
    } else {
        expr.text = first + " " + op + " " + display.text + " ="
        display.text = compute first, op, display.text
        first = display.text
        op = ""
        fresh = true
    }
}

clearBtn.on click {
    display.text = "0"
    expr.text = ""
    first = ""
    op = ""
    fresh = true
}

backBtn.on click {
    display.text = backspace display.text
    fresh = false
}

negBtn.on click {
    display.text = toggleSign display.text
}

window.on key press {
    if key = "D0" {
        display.text = appendDigit display.text, "0", fresh
        fresh = false
    } else if key = "D1" {
        display.text = appendDigit display.text, "1", fresh
        fresh = false
    } else if key = "D2" {
        display.text = appendDigit display.text, "2", fresh
        fresh = false
    } else if key = "D3" {
        display.text = appendDigit display.text, "3", fresh
        fresh = false
    } else if key = "D4" {
        display.text = appendDigit display.text, "4", fresh
        fresh = false
    } else if key = "D5" {
        display.text = appendDigit display.text, "5", fresh
        fresh = false
    } else if key = "D6" {
        display.text = appendDigit display.text, "6", fresh
        fresh = false
    } else if key = "D7" {
        display.text = appendDigit display.text, "7", fresh
        fresh = false
    } else if key = "D8" {
        display.text = appendDigit display.text, "8", fresh
        fresh = false
    } else if key = "D9" {
        display.text = appendDigit display.text, "9", fresh
        fresh = false
    } else if key = "OemPeriod" {
        display.text = appendDot display.text, fresh
        fresh = false
    } else if key = "Return" {
        if op = "" {
            op = ""
        } else {
            expr.text = first + " " + op + " " + display.text + " ="
            display.text = compute first, op, display.text
            first = display.text
            op = ""
            fresh = true
        }
    } else if key = "Back" {
        display.text = backspace display.text
        fresh = false
    } else if key = "Escape" {
        display.text = "0"
        expr.text = ""
        first = ""
        op = ""
        fresh = true
    }
}

window.show
