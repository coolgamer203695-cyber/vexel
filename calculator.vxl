plusBtn = add a button titled "+"
plusBtn.x = 296
plusBtn.y = 305
plusBtn.width = 84
plusBtn.height = 55
plusBtn.font_size = 16

zero = add a button titled "0"
zero.x = 20
zero.y = 370
zero.width = 174
zero.height = 55
