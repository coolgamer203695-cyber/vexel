// Praxis Calculator — single-file desktop calculator (Vexel 3.0).
// Check: vexel check calculator.vxl
// Run:   vexel calculator.vxl   (UI builds need the .NET 8 SDK)

function compute a, op, b {
    try {
        x = number of a
        y = number of b
        if op = "+" {
            out = x + y
        } else if op = "-" {
            out = x - y
        } else if op = "*" {
            out = x * y
        } else if op = "/" {
            if y = 0 {
                out = "Cannot divide by zero"
            } else {
                out = x / y
            }
        } else {
            out = y
        }
    } error {
        out = error.message
    }
    return out
}

function chopLast cur {
    if cur = "" {
        return ""
    }
    chopped = ""
    i = 0
    last = length of cur - 1
    repeat till i = last {
        chopped = chopped + [i] from cur
        i = i + 1
    }
    return chopped
}

function toggleSign cur {
    if cur = "" {
        return ""
    }
    if cur = "0" {
        return "0"
    }
    if [0] from cur = "-" {
        stripped = ""
        i = 1
        repeat till i = length of cur {
            stripped = stripped + [i] from cur
            i = i + 1
        }
        return stripped
    } else {
        return "-" + cur
    }
}

function appendDigit cur, digit, fresh {
    if fresh {
        return digit
    }
    if cur = "0" {
        return digit
    }
    return cur + digit
}

function appendDot cur, fresh {
    if fresh {
        return "0."
    }
    if cur = "" {
        return "0."
    }
    i = 0
    repeat till i = length of cur {
        if [i] from cur = "." {
            return cur
        }
        i = i + 1
    }
    return cur + "."
}

function backspace cur {
    chopped = chopLast cur
    if chopped = "" {
        return "0"
    }
    return chopped
}

create a window titled "Calculator"

use theme "dark"

window.width = 400
window.height = 500

expr = add a text titled ""
expr.x = 20
expr.y = 8
expr.width = 360
expr.height = 24
expr.alignment = "right"

display = add an output box
display.x = 20
display.y = 36
display.width = 360
display.height = 64
display.font_size = 28
display.text = "0"

clearBtn = add a button titled "C"
clearBtn.x = 20
clearBtn.y = 112
clearBtn.width = 82
clearBtn.height = 55
clearBtn.font_size = 16
clearBtn.tooltip = "Clear"

backBtn = add a button titled "<-"
backBtn.x = 112
backBtn.y = 112
backBtn.width = 82
backBtn.height = 55
backBtn.font_size = 16
backBtn.tooltip = "Backspace"

