// Atlas v0.5: the Atlas model library (`import atlas`).
// Shipped with Vexel — describes itself, builds configs, inspects
// folders. Model syntax (load/create/save/info, with inference) needs
// this import.

public version = "0.5"

// A ready-made 2-layer MLP config: relu hidden layer, linear output.
public function default_config input_size, hidden_size, output_size {
    l1 = { in = input_size, out = hidden_size, activation = "relu" }
    l2 = { in = hidden_size, out = output_size, activation = "none" }
    stack = [l1, l2]
    return { format = "atlas-model", format_version = 1, name = "mlp-relu", arch = "mlp", layers = stack }
}

// One-line summary of an info struct (from m.info or model info).
public function describe info {
    base = info.name + " [" + info.arch + "] " + info.layers + " layers, " + info.parameters + " parameters"
    if info.weights {
        return base + " (weights on disk, format v" + info.format_version + ")"
    }
    return base + " (config only, no weights, format v" + info.format_version + ")"
}

// True when the folder holds an Atlas config.json.
public function exists path {
    return file exists path + "/config.json"
}
