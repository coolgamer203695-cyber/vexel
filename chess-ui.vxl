    pending = 200
}

every 0.2 seconds {
    if pending = 100 {
        board = "rnbqkbnrpppppppp" + blank32
        board = board + "PPPPPPPPRNBQKBNR"
        turn = "white"
        wk = true
        wq = true
        bk = true
        bq = true
        ep = -1
        selected = -1
        over = false
        status.text = "White to move - click a piece"
        b0.text = sqAt board, 0
        b1.text = sqAt board, 1
        b2.text = sqAt board, 2
        b3.text = sqAt board, 3
        b4.text = sqAt board, 4
        b5.text = sqAt board, 5
        b6.text = sqAt board, 6
        b7.text = sqAt board, 7
        b8.text = sqAt board, 8
        b9.text = sqAt board, 9
        b10.text = sqAt board, 10
        b11.text = sqAt board, 11
        b12.text = sqAt board, 12
        b13.text = sqAt board, 13
        b14.text = sqAt board, 14
        b15.text = sqAt board, 15
        b16.text = sqAt board, 16
        b17.text = sqAt board, 17
        b18.text = sqAt board, 18
        b19.text = sqAt board, 19
        b20.text = sqAt board, 20
        b21.text = sqAt board, 21
        b22.text = sqAt board, 22
        b23.text = sqAt board, 23
        b24.text = sqAt board, 24
        b25.text = sqAt board, 25
        b26.text = sqAt board, 26
        b27.text = sqAt board, 27
        b28.text = sqAt board, 28
        b29.text = sqAt board, 29
        b30.text = sqAt board, 30
        b31.text = sqAt board, 31
        b32.text = sqAt board, 32
        b33.text = sqAt board, 33
        b34.text = sqAt board, 34
        b35.text = sqAt board, 35
        b36.text = sqAt board, 36
        b37.text = sqAt board, 37
        b38.text = sqAt board, 38
        b39.text = sqAt board, 39
        b40.text = sqAt board, 40
        b41.text = sqAt board, 41
        b42.text = sqAt board, 42
        b43.text = sqAt board, 43
        b44.text = sqAt board, 44
        b45.text = sqAt board, 45
        b46.text = sqAt board, 46
        b47.text = sqAt board, 47
        b48.text = sqAt board, 48
        b49.text = sqAt board, 49
        b50.text = sqAt board, 50
        b51.text = sqAt board, 51
        b52.text = sqAt board, 52
        b53.text = sqAt board, 53
        b54.text = sqAt board, 54
        b55.text = sqAt board, 55
        b56.text = sqAt board, 56
        b57.text = sqAt board, 57
        b58.text = sqAt board, 58
        b59.text = sqAt board, 59
        b60.text = sqAt board, 60
        b61.text = sqAt board, 61
        b62.text = sqAt board, 62
        b63.text = sqAt board, 63
        pending = -1
    } else if pending = 200 {
        if vsAI {
            vsAI = false
            aiWait = false
            modeBtn.text = "Mode: 2 Players"
            status.text = "Two player mode"
        } else {
            vsAI = true
            modeBtn.text = "Mode: Computer"
            if turn = "black" {
                aiWait = true
                status.text = "Computer is thinking..."
            } else {
                status.text = "You are White. Computer is Black."
            }
        }
        pending = -1
    } else if pending != -1 {
        if over = false {
            idx = pending
            isW = false
            if turn = "white" {
                isW = true
            }
            if selected = -1 {
                allow = true
                if vsAI {
                    if turn = "black" {
                        allow = false
                        status.text = "Wait for the computer."
                    }
                }
                if allow {
                    p = sqAt board, idx
                    mine = false
                    if p != " " {
                        if isW {
                            pc = pieceColor p
                            if pc = "white" {
                                mine = true
                            }
                        } else {
                            pc = pieceColor p
                            if pc = "black" {
                                mine = true
                            }
                        }
                    }
                    if mine {
                        selected = idx
                        msg = "Selected " + p
                        status.text = msg
                    } else {
                        if p = " " {
                            msg = turn + " to move"
                            status.text = msg
                        } else {
                            status.text = "Not your piece!"
                        }
                    }
                }
            } else {
                if selected = idx {
                    selected = -1
                    msg = turn + " to move"
                    status.text = msg
                } else {
                    pok = pseudoOk board, selected, idx, isW, ep, wk, wq, bk, bq
                    if pok {
                        sf = safeAfter board, selected, idx, isW, ep
                        if sf {
                            moving = sqAt board, selected
                            sr = rowOf selected
                            sc = colOf selected
                            dr2 = rowOf idx
                            dc = colOf idx
                            nb = setSq board, selected, " "
                            nb = setSq nb, idx, moving
                            if moving = "P" {
                                if sc != dc {
                                    was = sqAt board, idx
                                    if was = " " {
                                        if idx = ep {
                                            nb = setSq nb, sr * 8 + dc, " "
                                        }
                                    }
                                }
                            }
                            if moving = "p" {
                                if sc != dc {
                                    was = sqAt board, idx
                                    if was = " " {
                                        if idx = ep {
                                            nb = setSq nb, sr * 8 + dc, " "
                                        }
                                    }
                                }
                            }
                            if moving = "K" {
                                if idx = 62 {
                                    nb = setSq nb, 63, " "
                                    nb = setSq nb, 61, "R"
                                }
                                if idx = 58 {
                                    nb = setSq nb, 56, " "
                                    nb = setSq nb, 59, "R"
                                }
                            }
                            if moving = "k" {
                                if idx = 6 {
                                    nb = setSq nb, 7, " "
                                    nb = setSq nb, 5, "r"
                                }
                                if idx = 2 {
                                    nb = setSq nb, 0, " "
                                    nb = setSq nb, 3, "r"
                                }
                            }
                            board = nb
                            ep = -1
                            if moving = "P" {
                                if sr = 6 {
                                    if dr2 = 4 {
                                        er = sr - 1
                                        ep = er * 8 + dc
                                    }
                                }
                            }
                            if moving = "p" {
                                if sr = 1 {
                                    if dr2 = 3 {
                                        er = sr + 1
                                        ep = er * 8 + dc
                                    }
                                }
                            }
                            if moving = "K" {
                                wk = false
                                wq = false
                            }
                            if moving = "k" {
                                bk = false
                                bq = false
                            }
                            if selected = 63 {
                                wk = false
                            }
                            if idx = 63 {
                                wk = false
                            }
                            if selected = 56 {
                                wq = false
                            }
                            if idx = 56 {
                                wq = false
                            }
                            if selected = 7 {
                                bk = false
                            }
                            if idx = 7 {
                                bk = false
                            }
                            if selected = 0 {
                                bq = false
                            }
                            if idx = 0 {
                                bq = false
                            }
                            if moving = "P" {
                                if dr2 = 0 {
                                    choice = prompt "Promote to q, r, b or n:"
                                    make choice lower
                                    np = "Q"
                                    if choice = "r" {
                                        np = "R"
                                    }
                                    if choice = "b" {
                                        np = "B"
                                    }
                                    if choice = "n" {
                                        np = "N"
                                    }
                                    board = setSq board, idx, np
                                }
                            }
                            if moving = "p" {
                                if dr2 = 7 {
                                    if aiMoving {
                                        board = setSq board, idx, "q"
                                    } else {
                                        choice = prompt "Promote to q, r, b or n:"
                                        make choice lower
                                        np = "q"
                                        if choice = "r" {
                                            np = "r"
                                        }
                                        if choice = "b" {
                                            np = "b"
                                        }
                                        if choice = "n" {
                                            np = "n"
                                        }
                                        board = setSq board, idx, np
                                    }
                                }
                            }
                            if turn = "white" {
                                turn = "black"
                            } else {
                                turn = "white"
                            }
                            foeW = false
                            if turn = "white" {
                                foeW = true
                            }
                            chk2 = inCheck board, foeW
                            any = hasAny board, foeW, ep, wk, wq, bk, bq
                            if any = false {
                                if chk2 {
                                    if foeW {
                                        status.text = "Checkmate! Black wins."
                                        show message "Checkmate! Black wins."
                                    } else {
                                        status.text = "Checkmate! White wins."
                                        show message "Checkmate! White wins."
                                    }
                                } else {
                                    status.text = "Stalemate! Draw."
                                    show message "Stalemate! Draw."
                                }
                                over = true
                            } else {
                                if chk2 {
                                    if foeW {
                                        status.text = "White to move - check!"
                                    } else {
                                        status.text = "Black to move - check!"
                                    }
                                } else {
                                    if foeW {
                                        status.text = "White to move"
                                    } else {
                                        status.text = "Black to move"
                                    }
                                }
                                if vsAI {
                                    if turn = "black" {
                                        aiWait = true
                                        status.text = "Computer is thinking..."
                                    }
                                }
                            }
                        } else {
                            status.text = "Illegal move. Your king would be in check."
                        }
                    } else {
                        status.text = "Invalid move!"
                    }
                    selected = -1
                    aiMoving = false
                }
            }
            b0.text = sqAt board, 0
            b1.text = sqAt board, 1
            b2.text = sqAt board, 2
            b3.text = sqAt board, 3
            b4.text = sqAt board, 4
            b5.text = sqAt board, 5
            b6.text = sqAt board, 6
            b7.text = sqAt board, 7
            b8.text = sqAt board, 8
            b9.text = sqAt board, 9
            b10.text = sqAt board, 10
            b11.text = sqAt board, 11
            b12.text = sqAt board, 12
            b13.text = sqAt board, 13
            b14.text = sqAt board, 14
            b15.text = sqAt board, 15
            b16.text = sqAt board, 16
            b17.text = sqAt board, 17
            b18.text = sqAt board, 18
            b19.text = sqAt board, 19
            b20.text = sqAt board, 20
            b21.text = sqAt board, 21
            b22.text = sqAt board, 22
            b23.text = sqAt board, 23
            b24.text = sqAt board, 24
            b25.text = sqAt board, 25
            b26.text = sqAt board, 26
            b27.text = sqAt board, 27
            b28.text = sqAt board, 28
            b29.text = sqAt board, 29
            b30.text = sqAt board, 30
            b31.text = sqAt board, 31
            b32.text = sqAt board, 32
            b33.text = sqAt board, 33
            b34.text = sqAt board, 34
            b35.text = sqAt board, 35
            b36.text = sqAt board, 36
            b37.text = sqAt board, 37
            b38.text = sqAt board, 38
            b39.text = sqAt board, 39
            b40.text = sqAt board, 40
            b41.text = sqAt board, 41
            b42.text = sqAt board, 42
            b43.text = sqAt board, 43
            b44.text = sqAt board, 44
            b45.text = sqAt board, 45
            b46.text = sqAt board, 46
            b47.text = sqAt board, 47
            b48.text = sqAt board, 48
            b49.text = sqAt board, 49
            b50.text = sqAt board, 50
            b51.text = sqAt board, 51
            b52.text = sqAt board, 52
            b53.text = sqAt board, 53
            b54.text = sqAt board, 54
            b55.text = sqAt board, 55
            b56.text = sqAt board, 56
            b57.text = sqAt board, 57
            b58.text = sqAt board, 58
            b59.text = sqAt board, 59
            b60.text = sqAt board, 60
            b61.text = sqAt board, 61
            b62.text = sqAt board, 62
            b63.text = sqAt board, 63
        }
        pending = -1
    }
    if aiWait {
        aiWait = false
        if over = false {
            pending = -1
            synth = aiMoveText board, ep, wk, wq, bk, bq
            if synth = "" {
                status.text = "Computer has no move."
                over = true
            } else {
                code = parseMove synth
                asrc = 0
                rest = code
                repeat till rest < 64 {
                    rest = rest - 64
                    asrc = asrc + 1
                }
                adst = rest
                selected = asrc
                pending = adst
                aiMoving = true
            }
        }
    }
}

window.show
