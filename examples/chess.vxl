create a window titled "Vexel Chess"
window.width = 640
window.height = 680

status = add a text titled "White to move"
status.x = 20
status.y = 20
status.width = 600
status.height = 30
status.font_size = 16
status.bold = true

// 8x8 board - 64 buttons, 70px each with 2px gap = 576 + margins
board = []
i = 0
repeat 64 {
    board.add " "
    i = i + 1
}

// initial position
// black back rank 0-7
board[0] = "r"
board[1] = "n"
board[2] = "b"
board[3] = "q"
board[4] = "k"
board[5] = "b"
board[6] = "n"
board[7] = "r"
// black pawns 8-15
i = 8
repeat till i = 16 {
    board[i] = "p"
    i = i + 1
}
// white pawns 48-55
i = 48
repeat till i = 56 {
    board[i] = "P"
    i = i + 1
}
// white back rank 56-63
board[56] = "R"
board[57] = "N"
board[58] = "B"
board[59] = "Q"
board[60] = "K"
board[61] = "B"
board[62] = "N"
board[63] = "R"

selected = -1
turn = "white"

function pieceColor p {
    if p = " " {
        return "none"
    }
    if p = "K" {
        return "white"
    }
    if p = "Q" {
        return "white"
    }
    if p = "R" {
        return "white"
    }
    if p = "B" {
        return "white"
    }
    if p = "N" {
        return "white"
    }
    if p = "P" {
        return "white"
    }
    return "black"
}

function isWhite p {
    c = pieceColor p
    if c = "white" {
        return true
    }
    return false
}

function isBlack p {
    c = pieceColor p
    if c = "black" {
        return true
    }
    return false
}

function absVal n {
    if n < 0 {
        return 0 - n
    }
    return n
}

function validMove src, dst {
    piece = board[src]
    target = board[dst]
    if piece = " " {
        return false
    }
    // cannot capture own piece
    if pieceColor piece = pieceColor target {
        if target != " " {
            return false
        }
    }
    // must be correct turn
    if turn = "white" {
        if isBlack piece {
            return false
        }
    } else {
        if isWhite piece {
            return false
        }
    }
    fr = src / 8
    make fr number
    fc = src % 8
    tr = dst / 8
    make tr number
    tc = dst % 8
    dr = tr - fr
    dc = tc - fc
    adr = absVal dr
    adc = absVal dc
    // pawn
    if piece = "P" {
        // white pawn moves up (decreasing row)
        if dc = 0 {
            if dr = -1 {
                if target = " " {
                    return true
                }
            }
            if dr = -2 {
                if fr = 6 {
                    if target = " " {
                        mid = src - 8
                        if board[mid] = " " {
                            return true
                        }
                    }
                }
            }
        }
        if adc = 1 {
            if dr = -1 {
                if target != " " {
                    if isBlack target {
                        return true
                    }
                }
            }
        }
        return false
    }
    if piece = "p" {
        if dc = 0 {
            if dr = 1 {
                if target = " " {
                    return true
                }
            }
            if dr = 2 {
                if fr = 1 {
                    if target = " " {
                        mid = src + 8
                        if board[mid] = " " {
                            return true
                        }
                    }
                }
            }
        }
        if adc = 1 {
            if dr = 1 {
                if target != " " {
                    if isWhite target {
                        return true
                    }
                }
            }
        }
        return false
    }
    // knight
    if piece = "N" {
        if piece = "n" {
            // fallthrough handled by lower
        }
    }
    lp = piece
    make lp lower
    if lp = "n" {
        if adr = 2 {
            if adc = 1 {
                return true
            }
        }
        if adr = 1 {
            if adc = 2 {
                return true
            }
        }
        return false
    }
    if lp = "b" {
        if adr = adc {
            if adr > 0 {
                stepR = 1
                if dr < 0 {
                    stepR = -1
                }
                stepC = 1
                if dc < 0 {
                    stepC = -1
                }
                rr = fr + stepR
                cc = fc + stepC
                blocked = false
                repeat till rr = tr {
                    idx = rr * 8 + cc
                    if board[idx] != " " {
                        blocked = true
                    }
                    rr = rr + stepR
                    cc = cc + stepC
                }
                if blocked {
                    return false
                }
                return true
            }
        }
        return false
    }
    if lp = "r" {
        if dr = 0 {
            if adc > 0 {
                step = 1
                if dc < 0 {
                    step = -1
                }
                c = fc + step
                blocked = false
                repeat till c = tc {
                    idx = fr * 8 + c
                    if board[idx] != " " {
                        blocked = true
                    }
                    c = c + step
                }
                if blocked {
                    return false
                }
                return true
            }
        }
        if dc = 0 {
            if adr > 0 {
                step = 1
                if dr < 0 {
                    step = -1
                }
                r = fr + step
                blocked = false
                repeat till rr = tr {
                    idx = rr * 8 + cc
                    // c is still fc
                    idx2 = r * 8 + fc
                    if board[idx2] != " " {
                        blocked = true
                    }
                    r = r + step
                }
                if blocked {
                    return false
                }
                return true
            }
        }
        return false
    }
    if lp = "q" {
        // queen = bishop or rook
        if adr = adc {
            if adr > 0 {
                stepR = 1
                if dr < 0 {
                    stepR = -1
                }
                stepC = 1
                if dc < 0 {
                    stepC = -1
                }
                rr = fr + stepR
                cc = fc + stepC
                blocked = false
                repeat till rr = tr {
                    idx = rr * 8 + cc
                    if board[idx] != " " {
                        blocked = true
                    }
                    rr = rr + stepR
                    cc = cc + stepC
                }
                if blocked {
                    return false
                }
                return true
            }
        }
        if dr = 0 {
            if adc > 0 {
                step = 1
                if dc < 0 {
                    step = -1
                }
                c = fc + step
                blocked = false
                repeat till c = tc {
                    idx = fr * 8 + c
                    if board[idx] != " " {
                        blocked = true
                    }
                    c = c + step
                }
                if blocked {
                    return false
                }
                return true
            }
        }
        if dc = 0 {
            if adr > 0 {
                step = 1
                if dr < 0 {
                    step = -1
                }
                r = fr + step
                blocked = false
                repeat till rr = tr {
                    idx2 = r * 8 + fc
                    if board[idx2] != " " {
                        blocked = true
                    }
                    r = r + step
                }
                if blocked {
                    return false
                }
                return true
            }
        }
        return false
    }
    if lp = "k" {
        if adr <= 1 {
            if adc <= 1 {
                if adr + adc > 0 {
                    return true
                }
            }
        }
        return false
    }
    return false
}

