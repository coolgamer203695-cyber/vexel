function handleClick idx {
    if selected = -1 {
        p = board[idx]
        if p = " " {
            return 1
        }
        if turn = "white" {
            if isBlack p {
                status.text = "Not your piece!"
                return 1
            }
        } else {
            if isWhite p {
                status.text = "Not your piece!"
                return 1
            }
        }
        selected = idx
        status.text = "Selected " + p + " at " + idx
    } else {
        if selected = idx {
            selected = -1
            status.text = turn + " to move"
            return 1
        }
        ok = validMove selected, idx
        if ok {
            moving = board[selected]
            board[idx] = moving
            board[selected] = " "
            updateBoard
            if turn = "white" {
                turn = "black"
            } else {
                turn = "white"
            }
            status.text = turn + " to move"
            // pawn promotion
            toRow = idx / 8
            make toRow number
            if moving = "P" {
                if toRow = 0 {
                    board[idx] = "Q"
                    updateBoard
                }
            }
            if moving = "p" {
                if toRow = 7 {
                    board[idx] = "q"
                    updateBoard
                }
            }
        } else {
            status.text = "Invalid move!"
        }
        selected = -1
    }
    return 1
}

