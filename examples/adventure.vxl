// ============================================================
// RE:BORN — A Vexel Isekai Adventure
// 20 main quests, branching dialogue, 5 different endings.
// Your choices (and your courage) decide the ending.
// ============================================================

// ---------------- PROLOGUE: Truck-kun ----------------
struct Hero {
    name
    hp
    gold
    level
}
print "Episode 0: That Fateful Afternoon"
print ""
print "You step off the curb, phone in hand, when you hear it."
print " tires... A horn... A roar..."
print "TRUCK-KUN HAS STRUCK."
print ""
print "You wake on soft grass under two moons."
print "???: Oh no. Not again. Um... welcome, otherworlder!"
print "GODDESS LUMINA: I am Lumina. You died, sorry about that."
print "GODDESS LUMINA: Rules are rules: I must send you to the realm of Aerthys."
print "GODDESS LUMINA: But first, tell me your name, hero."
print ""
add input "Your name, hero?"
set output = nm
hero = Hero {
    name = "Nameless"
    hp = 100
    gold = 50
    level = 1
}
hero.name = nm
print "GODDESS LUMINA: What a fine name!"
print "GODDESS LUMINA: The letters of your name carry power."
print length of hero.name
print "GODDESS LUMINA: Choose one parting gift."
print "  1 = Sunsteel Sword (strike +4)"
print "  2 = Aegis Shield (start with 130 HP)"
print "  3 = Merchant Tome (+100 gold)"
add input "Gift (1-3)?"
set output = gift
bonus = 0
if gift = "1" {
    bonus = 4
    print "You take the SUNSTEEL SWORD. It hums with dawn."
} else if gift = "2" {
    hero.hp = 130
    print "You take the AEGIS SHIELD. You feel unbreakable."
} else if gift = "3" {
    hero.gold = hero.gold + 100
    print "You take the MERCHANT TOME. Coins love you now."
} else {
    print "GODDESS LUMINA: Indecisive... take my blessing instead! (+2)"
    bonus = 2
}
print "GODDESS LUMINA: Twenty trials await. The Demon Lord stirs."
print "GODDESS LUMINA: Go, and do not die too fast this time!"
print ""
potions = 2
ending = "none"
tearRiver = false
tearFlame = false
tearStone = false
mercy = false
allies = 0
party = ["You"]

// ---------------- QUEST 1: Slime Meadows ----------------
print "======================"
print "QUEST 1: Slime Meadows"
print "======================"
print "You arrive in Aerthys. A green slime wobbles toward you."
print "SLIME: Blorp... (it looks angry)"
print "Time for your first battle! Strike (1) or Potion (2)?"
foeHp = 25
repeat till foeHp <= 0 or hero.hp <= 0 {
    print "Slime HP: " + foeHp
    print "Your HP: " + hero.hp
    add input "Strike (1) or Potion (2)?"
    set output = move
    if move = "2" and potions > 0 {
        potions = potions - 1
        hero.hp = hero.hp + 25
        print "You quaff a potion. Warmth spreads."
    } else {
        hit = r from 8 to 15
        hit = hit + bonus
        foeHp = foeHp - hit
        print "You strike for " + hit
    }
    if foeHp > 0 {
        claw = r from 3 to 7
        hero.hp = hero.hp - claw
        print "The slime bonks you for " + claw
    }
}
if hero.hp <= 0 {
    print "The slime absorbs you. A short isekai..."
    print "ENDING: FALLEN on Quest 1."
    ending = "fallen"
}
if ending = "none" {
    print "Victory! The slime melts into goo and 30 gold."
    hero.gold = hero.gold + 30
    hero.level = hero.level + 1
    print "You are now level " + hero.level
}

// ---------------- QUEST 2: Ember Village ----------------
if ending = "none" {
    print ""
    print "======================"
    print "QUEST 2: Ember Village"
    print "======================"
    print "Elder MARLA greets you at the gates."
    print "MARLA: Rats eat our grain! Help us, hero?"
    print "  1 = Help for free (kind)"
    print "  2 = Demand 40 gold first"
    add input "Help (1) or Demand (2)?"
    set output = choice
    if choice = "2" {
        hero.gold = hero.gold + 40
        print "MARLA sighs and pays. The villagers side-eye you."
    } else {
        print "MARLA: Bless you! The village will remember this."
        allies = allies + 1
    }
    print "You descend into the cellar. Three giant rats hiss!"
    foeHp = 30
    repeat till foeHp <= 0 or hero.hp <= 0 {
        print "Rat swarm HP: " + foeHp
        add input "Strike (1) or Potion (2)?"
        set output = move
        if move = "2" and potions > 0 {
            potions = potions - 1
            hero.hp = hero.hp + 25
            print "You quaff a potion."
        } else {
            hit = r from 8 to 15
            hit = hit + bonus
            foeHp = foeHp - hit
            print "You strike for " + hit
        }
        if foeHp > 0 {
            claw = r from 3 to 8
            hero.hp = hero.hp - claw
            print "Rats nip you for " + claw
        }
    }
    if hero.hp <= 0 {
        print "The rats feast. Ember Village mourns."
        print "ENDING: FALLEN on Quest 2."
        ending = "fallen"
    }
    if ending = "none" {
        print "Cellar cleared! MARLA pays 40 gold."
        hero.gold = hero.gold + 40
        print "Gold: " + hero.gold
    }
}
// ---------------- QUEST 3: Whispering Forest ----------------
if ending = "none" {
    print ""
    print "============================"
    print "QUEST 3: Whispering Forest"
    print "============================"
    print "A crying boy runs up: his sister LIA is lost in the woods."
    print "  1 = Search the deep woods (dangerous)"
    print "  2 = Gather glow-herbs to light the paths (safe)"
    add input "Search (1) or Herbs (2)?"
    set output = choice
    if choice = "1" {
        print "You push into the dark. Wolves circle!"
        foeHp = 35
        repeat till foeHp <= 0 or hero.hp <= 0 {
            print "Wolf pack HP: " + foeHp
            add input "Strike (1) or Potion (2)?"
            set output = move
            if move = "2" and potions > 0 {
                potions = potions - 1
                hero.hp = hero.hp + 25
                print "You quaff a potion."
            } else {
                hit = r from 8 to 15
                hit = hit + bonus
                foeHp = foeHp - hit
                print "You strike for " + hit
            }
            if foeHp > 0 {
                claw = r from 4 to 8
                hero.hp = hero.hp - claw
                print "Wolves bite you for " + claw
            }
        }
        if hero.hp <= 0 {
            print "The forest keeps you. LIA is never found."
            print "ENDING: FALLEN on Quest 3."
            ending = "fallen"
        }
        if ending = "none" {
            print "You find LIA hiding in a hollow tree!"
            print "LIA: My brother will be so happy! Take my lucky charm."
            hero.gold = hero.gold + 60
            allies = allies + 1
        }
    } else {
        print "You gather moonlit glow-herbs."
        repeat 3 {
            print "You pick glowing herbs. +1 potion brewed."
            potions = potions + 1
        }
        print "Lanterns lit, the villagers find LIA at dawn."
        print "Potions: " + potions
        allies = allies + 1
    }
}

// ---------------- QUEST 4: Goblin Ambush ----------------
if ending = "none" {
    print ""
    print "=========================="
    print "QUEST 4: Goblin Ambush"
    print "=========================="
    print "On the kingsroad, merchant DORF screams: goblins!"
    foeHp = 40
    repeat till foeHp <= 0 or hero.hp <= 0 {
        print "Goblin gang HP: " + foeHp
        add input "Strike (1) or Potion (2)?"
        set output = move
        if move = "2" and potions > 0 {
            potions = potions - 1
            hero.hp = hero.hp + 25
            print "You quaff a potion."
        } else {
            hit = r from 8 to 15
            hit = hit + bonus
            foeHp = foeHp - hit
            print "You strike for " + hit
        }
        if foeHp > 0 {
            claw = r from 4 to 9
            hero.hp = hero.hp - claw
            print "Goblins slash you for " + claw
        }
    }
    if hero.hp <= 0 {
        print "The goblins loot your corpse. DORF flees."
        print "ENDING: FALLEN on Quest 4."
        ending = "fallen"
    }
    if ending = "none" {
        print "DORF: You saved my wagons! Take 70 gold!"
        hero.gold = hero.gold + 70
        print "DORF: Potions, get your potions! 20 gold each."
        print "Your gold: " + hero.gold
        print "  1 = Buy a potion (20 gold)"
        print "  2 = Save your money"
        add input "Buy (1) or Save (2)?"
        set output = buy
        if buy = "1" and hero.gold >= 20 {
            hero.gold = hero.gold - 20
            potions = potions + 1
            print "Bought! Potions: " + potions
        } else {
            print "DORF: Suit yourself, hero."
        }
    }
}

// ---------------- QUEST 5: Guild Exam ----------------
if ending = "none" {
    print ""
    print "========================"
    print "QUEST 5: Guild Exam"
    print "=========================="
    print "At the Adventurers Guild, receptionist MIRA eyes you."
    print "MIRA: To earn your Iron Rank, spar with the training dummy."
    party.add "Mira"
    print "MIRA joins your party! Members: " + party.length
    banner = hero.name
    make banner upper
    print "The arena banner reads: " + banner
    foeHp = 40
    print "The dummy cannot fight back. Show your form!"
    repeat till foeHp <= 0 {
        add input "Strike (1)?"
        set output = move
        hit = r from 10 to 16
        hit = hit + bonus
        foeHp = foeHp - hit
        print "You strike the dummy for " + hit
    }
    print "MIRA: Splendid footwork! IRON RANK granted."
    hero.level = hero.level + 1
    hero.hp = 100
    print "You are now level " + hero.level + ". Wounds treated."
}
// ---------------- QUEST 6: Spirit of the River ----------------
if ending = "none" {
    print ""
    print "=================================="
    print "QUEST 6: Spirit of the River"
    print "=================================="
    print "The river runs black with factory sludge."
    print "RIVER SPIRIT: My waters choke... will you help?"
    print "  1 = Spend the day cleaning the banks"
    print "  2 = Ignore her, push on to the capital"
    add input "Help (1) or Ignore (2)?"
    set output = choice
    if choice = "1" {
        print "You haul sludge till sunset. Fish leap again."
        print "RIVER SPIRIT: Take my TEAR, kind soul."
        tearRiver = true
        hero.hp = 100
        print "Her tear heals you fully."
    } else {
        print "You walk on. Behind you, the river weeps."
    }
}

// ---------------- QUEST 7: Spirit of the Flame ----------------
if ending = "none" {
    print ""
    print "=================================="
    print "QUEST 7: Spirit of the Flame"
    print "=================================="
    print "A volcano roars. FLAME SPIRIT blazes with rage."
    print "FLAME SPIRIT: WHO DARES CLIMB MY MOUNTAIN?"
    print "  1 = Fight him honorably"
    print "  2 = Sing the lullaby your mother taught you"
    print "  3 = Mock his tiny sparks"
    add input "Fight (1), Sing (2), Mock (3)?"
    set output = choice
    if choice = "3" {
        print "FLAME SPIRIT: TINY? I WILL SHOW YOU TINY!"
        foeHp = 45
        repeat till foeHp <= 0 or hero.hp <= 0 {
            print "Flame Spirit HP: " + foeHp
            add input "Strike (1) or Potion (2)?"
            set output = move
            if move = "2" and potions > 0 {
                potions = potions - 1
                hero.hp = hero.hp + 25
                print "You quaff a potion."
            } else {
                hit = r from 8 to 15
                hit = hit + bonus
                foeHp = foeHp - hit
                print "You strike for " + hit
            }
            if foeHp > 0 {
                claw = r from 5 to 10
                hero.hp = hero.hp - claw
                print "Flames scorch you for " + claw
            }
        }
        if hero.hp <= 0 {
            print "Ashes to ashes. The mountain forgets you."
            print "ENDING: FALLEN on Quest 7."
            ending = "fallen"
        }
        if ending = "none" {
            print "FLAME SPIRIT: ...Ha! Spirit! But no TEAR for mockers."
        }
    } else {
        if choice = "1" {
            print "You bow, draw steel, and spar for an hour."
        } else {
            print "Your lullaby echoes off the rocks. The flames soften."
        }
        print "FLAME SPIRIT: You have heart. Take my TEAR."
        tearFlame = true
        potions = potions + 1
    }
}

// ---------------- QUEST 8: Spirit of the Stone ----------------
if ending = "none" {
    print ""
    print "=================================="
    print "QUEST 8: Spirit of the Stone"
    print "=================================="
    print "STONE SPIRIT: Answer, mortal, and earn my TEAR."
    print "STONE SPIRIT: I speak without a mouth and hear without ears."
    print "STONE SPIRIT: I have no body, but I come alive with wind."
    print "STONE SPIRIT: What am I? (whisper it in lowercase)"
    add input "Answer:"
    set output = ans
    if ans = "echo" or ans = "Echo" {
        print "STONE SPIRIT: Correct. Take my TEAR."
        tearStone = true
    } else {
        print "STONE SPIRIT: Wrong. The mountain dorms are closed to you."
        print "Pebble golems pelt you as you leave!"
        hero.hp = hero.hp - 10
        print "Your HP: " + hero.hp
        if hero.hp <= 0 {
            print "Pelted to death by pebbles. Humiliating."
            print "ENDING: FALLEN on Quest 8."
            ending = "fallen"
        }
    }
}
// ---------------- QUEST 9: Haunted Mine ----------------
