eqBtn.x = 296
eqBtn.y = 370
eqBtn.width = 84
eqBtn.height = 55
eqBtn.font_size = 16

first = ""
op = ""
fresh = true

seven.on click {
    display.text = logic.appendDigit display.text, "7", fresh
    fresh = false
}

eight.on click {
    display.text = logic.appendDigit display.text, "8", fresh
    fresh = false
}

nine.on click {
    display.text = logic.appendDigit display.text, "9", fresh
    fresh = false
}

four.on click {
    display.text = logic.appendDigit display.text, "4", fresh
    fresh = false
}

five.on click {
    display.text = logic.appendDigit display.text, "5", fresh
    fresh = false
}

six.on click {
    display.text = logic.appendDigit display.text, "6", fresh
    fresh = false
}

one.on click {
    display.text = logic.appendDigit display.text, "1", fresh
    fresh = false
}

two.on click {
    display.text = logic.appendDigit display.text, "2", fresh
    fresh = false
}

three.on click {
    display.text = logic.appendDigit display.text, "3", fresh
    fresh = false
}

zero.on click {
    display.text = logic.appendDigit display.text, "0", fresh
    fresh = false
}

dotBtn.on click {
    display.text = logic.appendDot display.text, fresh
    fresh = false
}

plusBtn.on click {
    if op = "" {
        first = display.text
    } else {
        if fresh = false {
            first = logic.compute first, op, display.text
            display.text = first
        }
    }
    op = "+"
    fresh = true
}

subBtn.on click {
    if op = "" {
        first = display.text
    } else {
        if fresh = false {
            first = logic.compute first, op, display.text
            display.text = first
        }
    }
    op = "-"
    fresh = true
}

mulBtn.on click {
    if op = "" {
        first = display.text
    } else {
        if fresh = false {
            first = logic.compute first, op, display.text
            display.text = first
        }
    }
    op = "*"
    fresh = true
}

divBtn.on click {
    if op = "" {
        first = display.text
    } else {
        if fresh = false {
            first = logic.compute first, op, display.text
            display.text = first
        }
    }
    op = "/"
    fresh = true
}

eqBtn.on click {
    if op = "" {
        op = ""
    } else {
        display.text = logic.compute first, op, display.text
        first = display.text
        op = ""
        fresh = true
    }
}

clearBtn.on click {
    display.text = "0"
    first = ""
    op = ""
    fresh = true
}

backBtn.on click {
    display.text = logic.backspace display.text
    fresh = false
}

negBtn.on click {
    display.text = logic.toggleSign display.text
}

window.on key press {
    if key = "D0" {
        display.text = logic.appendDigit display.text, "0", fresh
        fresh = false
    } else if key = "NumPad0" {
        display.text = logic.appendDigit display.text, "0", fresh
        fresh = false
    } else if key = "D1" {
        display.text = logic.appendDigit display.text, "1", fresh
        fresh = false
    } else if key = "NumPad1" {
        display.text = logic.appendDigit display.text, "1", fresh
        fresh = false
    } else if key = "D2" {
        display.text = logic.appendDigit display.text, "2", fresh
        fresh = false
    } else if key = "NumPad2" {
        display.text = logic.appendDigit display.text, "2", fresh
        fresh = false
    } else if key = "D3" {
        display.text = logic.appendDigit display.text, "3", fresh
        fresh = false
    } else if key = "NumPad3" {
        display.text = logic.appendDigit display.text, "3", fresh
        fresh = false
    } else if key = "D4" {
        display.text = logic.appendDigit display.text, "4", fresh
        fresh = false
    } else if key = "NumPad4" {
        display.text = logic.appendDigit display.text, "4", fresh
        fresh = false
    } else if key = "D5" {
        display.text = logic.appendDigit display.text, "5", fresh
        fresh = false
    } else if key = "NumPad5" {
        display.text = logic.appendDigit display.text, "5", fresh
        fresh = false
    } else if key = "D6" {
        display.text = logic.appendDigit display.text, "6", fresh
        fresh = false
    } else if key = "NumPad6" {
        display.text = logic.appendDigit display.text, "6", fresh
        fresh = false
    } else if key = "D7" {
        display.text = logic.appendDigit display.text, "7", fresh
        fresh = false
    } else if key = "NumPad7" {
        display.text = logic.appendDigit display.text, "7", fresh
        fresh = false
    } else if key = "D8" {
        display.text = logic.appendDigit display.text, "8", fresh
        fresh = false
    } else if key = "NumPad8" {
        display.text = logic.appendDigit display.text, "8", fresh
        fresh = false
    } else if key = "D9" {
        display.text = logic.appendDigit display.text, "9", fresh
        fresh = false
    } else if key = "NumPad9" {
        display.text = logic.appendDigit display.text, "9", fresh
        fresh = false
    } else if key = "OemPeriod" {
        display.text = logic.appendDot display.text, fresh
        fresh = false
    } else if key = "Decimal" {
        display.text = logic.appendDot display.text, fresh
        fresh = false
    } else if key = "Add" {
        if op = "" {
            first = display.text
        } else {
            if fresh = false {
                first = logic.compute first, op, display.text
                display.text = first
            }
        }
        op = "+"
        fresh = true
    } else if key = "Oemplus" {
        if op = "" {
            first = display.text
        } else {
            if fresh = false {
                first = logic.compute first, op, display.text
                display.text = first
            }
        }
        op = "+"
        fresh = true
    } else if key = "Subtract" {
        if op = "" {
            first = display.text
        } else {
            if fresh = false {
                first = logic.compute first, op, display.text
                display.text = first
            }
        }
        op = "-"
        fresh = true
    } else if key = "OemMinus" {
        if op = "" {
            first = display.text
        } else {
            if fresh = false {
                first = logic.compute first, op, display.text
                display.text = first
            }
        }
        op = "-"
        fresh = true
    } else if key = "Multiply" {
        if op = "" {
            first = display.text
        } else {
            if fresh = false {
                first = logic.compute first, op, display.text
                display.text = first
            }
        }
        op = "*"
        fresh = true
    } else if key = "Divide" {
        if op = "" {
            first = display.text
        } else {
            if fresh = false {
                first = logic.compute first, op, display.text
                display.text = first
            }
        }
        op = "/"
        fresh = true
    } else if key = "Return" {
        if op = "" {
            op = ""
        } else {
            display.text = logic.compute first, op, display.text
            first = display.text
            op = ""
            fresh = true
        }
    } else if key = "Back" {
        display.text = logic.backspace display.text
        fresh = false
    } else if key = "Escape" {
        display.text = "0"
        first = ""
        op = ""
        fresh = true
    } else if key = "C" {
        display.text = "0"
        first = ""
        op = ""
        fresh = true
    }
}

window.show
