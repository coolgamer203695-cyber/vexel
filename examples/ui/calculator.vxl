current = ""
first = ""
op = ""

seven.on click {
    current = current + "7"
    display.text = current
}

eight.on click {
    current = current + "8"
    display.text = current
}

nine.on click {
    current = current + "9"
    display.text = current
}

four.on click {
    current = current + "4"
    display.text = current
}

five.on click {
    current = current + "5"
    display.text = current
}

six.on click {
    current = current + "6"
    display.text = current
}

one.on click {
    current = current + "1"
    display.text = current
}

two.on click {
    current = current + "2"
    display.text = current
}

three.on click {
    current = current + "3"
    display.text = current
}

zero.on click {
    current = current + "0"
    display.text = current
}

decimal.on click {
    current = current + "."
    display.text = current
}

plus.on click {
    first = current
    op = "+"
    current = ""
    display.text = ""
}

subtract.on click {
    first = current
    op = "-"
    current = ""
    display.text = ""
}

multiply.on click {
    first = current
    op = "*"
    current = ""
    display.text = ""
}

divide.on click {
    first = current
    op = "/"
    current = ""
    display.text = ""
}

equals.on click {
    second = display.text
    try {
        f = number of first
        s = number of second
        if op = "+" {
            result = f + s
        } else if op = "-" {
            result = f - s
        } else if op = "*" {
            result = f * s
        } else if op = "/" {
            if s = 0 {
                result = "Cannot divide by zero"
            } else {
                result = f / s
            }
        } else {
            result = s
        }
        display.text = result
        current = display.text
    } error {
        display.text = error.message
    }
}

clearBtn.on click {
    display.text = ""
    first = ""
    op = ""
    current = ""
}

window.show
