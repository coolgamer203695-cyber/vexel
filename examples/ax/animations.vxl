create a window titled "Ax Fade"

box = add a button titled "Box"
box.x = 20
box.y = 20
box.width = 120
box.height = 50
box.opacity = 0.5

animate box {
    move to x 200
    fade to 0.9
    duration 1 second
}

fin = after 2 seconds {
    json write box.x to "ax_fade_x.json"
    json write box.opacity to "ax_fade_op.json"
}

window.show
