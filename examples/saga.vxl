    if choice = "1" {
        print "Cups raise. Names are spoken into the steam."
        print "Nobody cries. Everybody lies about not crying."
    } else {
        print "Laughter shakes the table. JUNO conducts with a spoon."
        print "SABLE carves an extra helping for the road."
        potions = potions + 1
    }
    print "Full hearts. Full HP. Sleep comes fast."
    hero.hp = 140
}
// ---------------- INTERLUDE 8: The Cartographer's Debt ----------------
if ending = "none" {
    print ""
    print "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    print "Interlude: the cartographer's debt"
    print "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    print "CARTOGRAPHER PETRA blocks the war-room door, arms crossed."
    print "PETRA: Thirty-eight quests of my maps and not one thank-you!"
    print "PETRA: Fifteen gold for the atlas. Pay up, legend."
    print "Your gold: " + hero.gold
    print "Relics carried: " + relics.length
    print "  1 = Pay 15 gold"
    print "  2 = Wash her brushes (two hours of scrubbing)"
    print "  3 = Show off your relic collection instead"
    add input "Pay (1), Wash (2), Show (3)?"
    set output = choice
    if choice = "1" and hero.gold >= 15 {
        hero.gold = hero.gold - 15
        print "PETRA stamps PAID across your forehead. Worth it."
    } else if choice = "3" and relics.length >= 5 {
        print "PETRA pages through your relics, spectacles fogging."
        print "PETRA: The debt is FORGIVEN. And... may I sketch the Pearl Oath?"
        allies = allies + 1
    } else {
        if choice = "1" {
            print "PETRA looks at your lint. Brushes it is, then."
        } else {
            print "PETRA: The brushes! The ink pots! My poor assistant's day off!"
        }
        repeat 2 {
            print "You scrub maps until the seas shine."
        }
        print "Debt paid in elbow grease. PETRA almost smiles."
    }
    print "MADAME ZOLA the fortune-teller grabs your wrist on the way out."
    print "ZOLA: One omen, free, because your face worries me."
    omen = r from 1 to 3
    if omen = 1 {
        print "ZOLA: I see GOLD. Boring. Accurate. Take 20 for luck."
        hero.gold = hero.gold + 20
    } else if omen = 2 {
        print "ZOLA: I see SOUP. Eat some before the battle, darling."
        potions = potions + 1
    } else {
        print "ZOLA: I see... YOU. Older. Smiling. That is the whole omen."
        hero.hp = 140
        print "You stand a little straighter. HP restored to 140."
    }
}
