    print "OSSUS: One was a cloud. It never returned its books."
    print "OSSUS: The Gale Crown Shard sits in Restricted. Answer, borrower."
    print "OSSUS: What runs but never walks, has a mouth but never talks,"
    print "OSSUS: has a bed but never sleeps? (lowercase)"
    add input "Answer:"
    set output = ans
    if ans = "river" or ans = "River" {
        print "OSSUS: Exquisite. Take the shard. And a bookmark."
