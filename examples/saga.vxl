print "======================"
if ending = "star" {
    print "STARFORGED — THE TRUE ENDING"
    print "The moons shine whole, and your name is written across them."
    print "No Hollow. No hunger. Just tides, and stew, and naps."
    print "The phoenix nests atop the lighthouse. The river runs gin-clear."
    print "GLACIA sends a postcard every winter. It just says: COLD. WORTH IT."
    if mercy {
        print "The spared and the forgiven raise the first toast."
    }
}
if ending = "guardian" {
    print "GUARDIAN — ENDING"
    print "Your sword holds the sky shut. Gulls nest on the pommel."
    print "Every spring, the villages polish it and tell your story wrong."
    print "The sword never rusts. The flowers never stop coming."
    if mercy {
        print "They always remember the mercy part right, though."
    }
}
if ending = "wanderer" {
    print "WANDERER — ENDING"
    print "Cracked sky, whole fish. A fair trade, you insist."
    print "On clear nights you count the cracks and feel almost guilty."
    print "Almost. The stew is excellent. The naps are legendary."
}
if ending = "shadow" {
    print "HOLLOW — ENDING. Gentle. Final. Quiet."
    print "Somewhere, a goddess keeps a seat warm you will never take."
}
if ending = "fallen" {
    print "FALLEN — ENDING. Lumina files the paperwork. Again."
    print "She keeps your file on top of the pile. Her favorite regular."
}
