print "Level: " + hero.level
print "Gold: " + hero.gold
print "Allies: " + allies
print "Shards: " + shard
print "Relics: " + relics.length
print "Party members: " + party.length
print "Potions left: " + potions
print "Final strike bonus: " + bonus
