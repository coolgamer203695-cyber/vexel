    basket.add "pepper"
    basket.add "sky-apple"
    print "Your basket holds " + basket.length + " wonders:"
    print basket[0]
    print basket[1]
    print basket[2]
    print "The judges taste. The crowd holds its breath."
    judge = r from 1 to 10
    print "Score: " + judge + " out of 10"
    if judge >= 6 {
        print "FIRST PRIZE! 60 gold and the Golden Ladle (replica)!"
        hero.gold = hero.gold + 60
        relics.add "Golden Ladle"
    } else {
        print "Honorable mention. The ladle goes to a soup wizard."
        hero.gold = hero.gold + 10
    }
    print "Then the DANCE-OFF. JUNO shoves you into the circle."
    print "The crowd chants your name. Impress them: dance big (1) or smooth (2)?"
    add input "Big (1) or Smooth (2)?"
    set output = style
    judge = r from 1 to 10
    if style = "1" {
        judge = judge + 2
    }
    print "The judges hold up " + judge
    if judge >= 8 {
        print "The circle ERUPTS. +30 gold thrown in hats!"
        hero.gold = hero.gold + 30
    } else {
        print "Polite applause. A child out-dances you. Humbling."
    }
    print "Dancing till dawn. HP restored to 130."
    hero.hp = 130
}
// ---------------- INTERLUDE 7: The Last Supper ----------------
if ending = "none" {
    print ""
    print "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    print "Interlude: the last supper"
    print "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
