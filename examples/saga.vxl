// ============================================================
// RE:BORN II: THE SHATTERED SKY — A Vexel Saga
// 40 main quests, 8 interludes, branching dialogue, 5 endings.
// A sequel to RE:BORN. Your old saga echoes into this one.
// ============================================================

struct Hero {
    name
    hp
    gold
    level
}

// ---------------- PROLOGUE: Tides of Fate ----------------
print "=================================================="
print "RE:BORN II: THE SHATTERED SKY"
print "=================================================="
print ""
print "Three moons once watched over Aerthys. Now they are cracked,"
print "and through the cracks leaks the HOLLOW — a hunger unending."
print "The bards still sing of the hero of the last war..."
print "Was that hero... you?"
print ""
print "  1 = Yes — I bore the Dawn (the true ending)"
print "  2 = Yes — I sealed the dark with my life"
print "  3 = That is a tale for another fire"
add input "Your legend (1-3)?"
set output = recap
hero = Hero {
    name = "Nameless"
    hp = 100
    gold = 60
    level = 5
}
potions = 3
bonus = 0
healAmt = 25
if recap = "1" {
    print "The moons remember you, Dawnbringer. Take this charm."
    potions = potions + 2
    print "Potions: " + potions
} else if recap = "2" {
    print "The seal remembers your sacrifice. Your old sword returns."
    bonus = bonus + 2
    print "Strike bonus: " + bonus
    } else {
        print "A stranger with no past. The road provides: +50 gold."
        print "LUMINA squints at you. LUMINA: ...Have we met? Whatever. Onward!"
        hero.gold = hero.gold + 50
    }
print ""
print "GODDESS LUMINA: Darling! Back again! Dying agrees with you."
print "GODDESS LUMINA: Name yourself anew, hero."
add input "Your name, hero?"
set output = nm
hero.name = nm
print "GODDESS LUMINA: Lovely. Now choose how you fight."
print "  1 = WARRIOR (strike +3, sturdy)"
print "  2 = ROGUE (strike +1, +80 gold, quick hands)"
print "  3 = MAGE (strike +2, strong heals of 35)"
add input "Class (1-3)?"
set output = cls
if cls = "1" {
    bonus = bonus + 3
    print "WAR-CAPTAIN SELKA salutes you. WARRIOR it is."
} else if cls = "2" {
    bonus = bonus + 1
    hero.gold = hero.gold + 80
    print "A masked FOX winks. ROGUE it is. Pockets heavier already."
} else {
    bonus = bonus + 2
    healAmt = 35
    print "ARCHMAGE VEY bows. MAGE it is. Your vials glow blue."
}
print "GODDESS LUMINA: Thirty-eight trials. Four Crown Shards to find."
print "GODDESS LUMINA: One sleeps with water, one with fire and frost."
print "GODDESS LUMINA: One hides in clouds, one in a phoenix breast."
print "GODDESS LUMINA: Gather them, gather friends, and mind the Hollow."
print "GODDESS LUMINA: It offers kindness first. That is how it eats."
print ""
print "GODDESS LUMINA: A scroll of instructions, since you always forget:"
print "GODDESS LUMINA: Answer numbered choices by typing the number."
print "GODDESS LUMINA: In battle, 1 strikes and 2 drinks a red potion."
print "GODDESS LUMINA: Potions heal. Shops sell them. Death is forever."
print "GODDESS LUMINA: Riddles want lowercase answers. Gold opens doors."
print "GODDESS LUMINA: Now go. Be interesting!"
print "GODDESS LUMINA: Seal the Hollow King — or join him. Try to be interesting!"
print ""
ending = "none"
shard = 0
mercy = false
allies = 0
relics = ["Old Coin"]
party = ["You"]
// ---------------- QUEST 1: Crabbing Rights ----------------
if ending = "none" {
    print ""
    print "==========================="
    print "QUEST 1: Crabbing Rights"
    print "==========================="
    print "You wash up on a singing beach. A crab the size of a dog"
    print "claims your left boot as its bride."
    print "CRAB: Clack. (Translation: battle.)"
    foeHp = 25
    repeat till foeHp <= 0 or hero.hp <= 0 {
        print "Giant Crab HP: " + foeHp
        print "Your HP: " + hero.hp
        add input "Strike (1) or Potion (2)?"
        set output = move
        if move = "2" and potions > 0 {
            potions = potions - 1
            hero.hp = hero.hp + healAmt
            print "You quaff a potion."
        } else {
            hit = r from 8 to 15
            hit = hit + bonus
            foeHp = foeHp - hit
            print "You strike for " + hit
        }
        if foeHp > 0 {
            claw = r from 3 to 7
            hero.hp = hero.hp - claw
            print "Claws snap you for " + claw
        }
    }
    if hero.hp <= 0 {
        print "Pinched to death on page one. The bards laugh."
        print "ENDING: FALLEN on Quest 1."
        ending = "fallen"
    }
    if ending = "none" {
        print "Crab defeated! Dinner AND 25 gold."
        hero.gold = hero.gold + 25
        hero.level = hero.level + 1
        print "You are now level " + hero.level
    }
}

// ---------------- QUEST 2: Saltspire Village ----------------
if ending = "none" {
    print ""
    print "=============================="
    print "QUEST 2: Saltspire Village"
    print "=============================="
    print "Saltspray, gulls, and MAYOR PELL wringing his hat."
    print "PELL: Our lighthouse ghost scares every ship! Talk to it?"
    print "  1 = Climb the lighthouse (spooky)"
    print "  2 = Patrol the market first (earn coin)"
    add input "Lighthouse (1) or Market (2)?"
    set output = choice
    if choice = "2" {
        print "You catch three pickpockets and a runaway goat."
        print "The market pays 45 gold."
        hero.gold = hero.gold + 45
    } else {
        print "You march straight to the haunted hill."
        allies = allies + 1
        print "PELL admires your nerve. The town watches hopefully."
        print "PELL: My grandmother faced that ghost. Left her a whole pie."
        print "PELL: Just so you know what courage looks like, hero."
    }
    print "Trader FENN waves from her stall."
    print "FENN: Potions, 20 gold. Heroes always need potions."
    print "Your gold: " + hero.gold
    print "  1 = Buy a potion"
    print "  2 = Save your money"
    add input "Buy (1) or Save (2)?"
    set output = buy
    if buy = "1" and hero.gold >= 20 {
        hero.gold = hero.gold - 20
        potions = potions + 1
        print "Bought! Potions: " + potions
    } else {
        print "FENN: Next time, then. Try not to die."
    }
}

// ---------------- QUEST 3: The Drowned Light ----------------
if ending = "none" {
    print ""
    print "================================"
    print "QUEST 3: The Drowned Light"
    print "================================"
    print "The lighthouse lamp is cold. A GHOST keeps relighting it wrong."
    print "GHOST: ...sss... the ships... must... see..."
    print "  1 = Listen to her story"
    print "  2 = Exorcise her on the spot"
    add input "Listen (1) or Exorcise (2)?"
    set output = choice
    if choice = "1" {
        print "She was KEEPER WREN. She died mid-storm, lamp unlit."
        print "You light the lamp together. Dawn breaks over the waves."
        print "WREN: At last... take my brass key. And my blessing."
        hero.gold = hero.gold + 55
        allies = allies + 1
        print "Her blessing warms you. HP restored to 110."
        hero.hp = 110
    } else {
        print "Your half-remembered rite mostly works. Mostly."
        print "The ghost leaves, annoyed. The lamp stays dark one more night."
        hero.hp = hero.hp - 8
        print "Spiritual backlash! Your HP: " + hero.hp
        if hero.hp <= 0 {
            print "Exorcised yourself by accident. Awkward."
            print "ENDING: FALLEN on Quest 3."
            ending = "fallen"
        }
    }
}

// ---------------- QUEST 4: Tide Cave ----------------
if ending = "none" {
    print ""
    print "========================="
    print "QUEST 4: Tide Cave"
    print "========================="
    print "Fisher KID says the tide took his father into the cave."
    print "Inside: a DROWNED KNIGHT guards the stranded sailors."
    foeHp = 35
    repeat till foeHp <= 0 or hero.hp <= 0 {
        print "Drowned Knight HP: " + foeHp
        add input "Strike (1) or Potion (2)?"
        set output = move
        if move = "2" and potions > 0 {
            potions = potions - 1
            hero.hp = hero.hp + healAmt
            print "You quaff a potion."
        } else {
            hit = r from 8 to 15
            hit = hit + bonus
            foeHp = foeHp - hit
            print "You strike for " + hit
        }
        if foeHp > 0 {
            claw = r from 4 to 8
            hero.hp = hero.hp - claw
            print "Rusted blade cuts you for " + claw
        }
    }
    if hero.hp <= 0 {
        print "The tide keeps you too."
        print "ENDING: FALLEN on Quest 4."
        ending = "fallen"
    }
    if ending = "none" {
        print "The knight kneels, freed, and fades into foam."
        print "KID: FATHER! The sailors weep and laugh at once."
        print "The sailors carry you home singing. +60 gold."
        hero.gold = hero.gold + 60
        allies = allies + 1
    }
}
// ---------------- INTERLUDE 1: Campfire Dice ----------------
if ending = "none" {
    print ""
    print "~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    print "Campfire: a dice game"
    print "~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    print "Scout JUNO shakes a bone die. Even or odd, 10 gold a throw?"
    print "  1 = Bet EVEN"
    print "  2 = Bet ODD"
    print "  3 = No gambling tonight"
    add input "Even (1), Odd (2), Pass (3)?"
    set output = choice
    if choice = "3" {
        print "JUNO pouts. The fire crackles. HP restored to 110."
        hero.hp = 110
    } else if hero.gold >= 10 {
        roll = r from 1 to 6
        print "The die shows " + roll
        won = false
        if roll % 2 == 0 and choice = "1" {
            won = true
        }
        if roll % 2 == 1 and choice = "2" {
            won = true
        }
        if won {
            print "JUNO pays 20 gold, cursing beautifully."
            hero.gold = hero.gold + 20
        } else {
            print "JUNO takes your 10 gold, grinning."
            hero.gold = hero.gold - 10
        }
        print "Gold: " + hero.gold
    } else {
        print "Not enough gold. JUNO lends you her blanket instead."
        hero.hp = 110
    }
}

// ---------------- QUEST 5: Caravan of Dust ----------------
if ending = "none" {
    print ""
    print "=================================="
    print "QUEST 5: Caravan of Dust"
    print "=================================="
    print "The Ashen Desert. A caravan master, SABLE, hires blades."
    print "SABLE: Bandits hit at the red dune. Ride with us?"
    print "Bandit horns howl before she finishes."
    foeHp = 40
    repeat till foeHp <= 0 or hero.hp <= 0 {
        print "Bandit crew HP: " + foeHp
        add input "Strike (1) or Potion (2)?"
        set output = move
        if move = "2" and potions > 0 {
            potions = potions - 1
            hero.hp = hero.hp + healAmt
            print "You quaff a potion."
        } else {
            hit = r from 9 to 16
            hit = hit + bonus
            foeHp = foeHp - hit
            print "You strike for " + hit
        }
        if foeHp > 0 {
            claw = r from 4 to 9
            hero.hp = hero.hp - claw
            print "Curved blades nick you for " + claw
        }
    }
    if hero.hp <= 0 {
        print "The desert keeps what it catches."
        print "ENDING: FALLEN on Quest 5."
        ending = "fallen"
    }
    if ending = "none" {
        print "SABLE laughs all the way back to the wagons."
        print "SABLE: I once saw a hero fight a dune with a spoon. You are better."
        print "SABLE: Marginally. Do not let it go to your head."
        print "SABLE: You fight like a sandstorm! 70 gold and my blade besides."
        print "SABLE joins your party!"
        party.add "Sable"
        hero.gold = hero.gold + 70
        allies = allies + 1
        print "Party members: " + party.length
    }
}

// ---------------- QUEST 6: Oasis of Glass ----------------
if ending = "none" {
    print ""
    print "================================"
    print "QUEST 6: Oasis of Glass"
    print "================================"
    print "A girl made of living water blocks the oasis pool."
    print "ONDINE: Travelers foul my pool. Prove you are different."
    print "  1 = Clean the pool edge silently"
    print "  2 = Offer her your own drinking water"
    print "  3 = Push past — you are in a hurry"
    add input "Clean (1), Offer (2), Push (3)?"
    set output = choice
    if choice = "3" {
        print "ONDINE freezes the pool solid. Your boots stick. Your dignity cracks."
        print "You chip yourself free, poorer in pride and 12 HP."
        hero.hp = hero.hp - 12
        print "Your HP: " + hero.hp
        if hero.hp <= 0 {
            print "Death by dignity. The desert is merciless."
            print "ENDING: FALLEN on Quest 6."
            ending = "fallen"
        }
    } else {
        if choice = "1" {
            print "You scrub algae till the pool mirrors the sky."
        } else {
            print "You pour your last flask in. ONDINE tastes it, solemn."
        }
        print "ONDINE: The first Crown Shard is yours, kind one."
        shard = shard + 1
        relics.add "Glass Shard"
        print "Crown Shards: " + shard
        hero.hp = 110
    }
}

// ---------------- QUEST 7: The Pit ----------------
if ending = "none" {
    print ""
    print "========================"
    print "QUEST 7: The Pit"
    print "========================"
    print "Duneburg's fighting pit. PITBOSS GRIN counts teeth for purses."
    print "GRIN: Last three rounds, win the Ember Crown Shard. Enter?"
    print "  1 = Enter the pit"
    print "  2 = Politely decline and shop instead"
    add input "Enter (1) or Shop (2)?"
    set output = choice
    if choice = "2" {
        print "GRIN shrugs. You buy dates and a spare buckle. +1 potion."
        potions = potions + 1
    } else {
        round = 1
        repeat 3 {
            print "--- Pit bout " + round + " ---"
            foeHp = 25 + round * 10
            repeat till foeHp <= 0 or hero.hp <= 0 {
                print "Pit foe HP: " + foeHp
                add input "Strike (1) or Potion (2)?"
                set output = move
                if move = "2" and potions > 0 {
                    potions = potions - 1
                    hero.hp = hero.hp + healAmt
                    print "You quaff a potion."
                } else {
                    hit = r from 9 to 16
                    hit = hit + bonus
                    foeHp = foeHp - hit
                    print "You strike for " + hit
                }
                if foeHp > 0 {
                    claw = r from 4 to 9
                    hero.hp = hero.hp - claw
                    print "You take " + claw + " damage"
                }
            }
            if hero.hp <= 0 {
                print "Carried out feet-first. The crowd boos the stretcher."
                print "ENDING: FALLEN on Quest 7."
                ending = "fallen"
            }
            if ending = "none" {
                print "Bout won! Sawdust, sweat, cheers."
                print "The pit doctor slaps you awake. +25 HP."
                hero.hp = hero.hp + 25
                round = round + 1
            }
        }
        if ending = "none" {
            print "GRIN: CHAMPION OF THE PIT! The Ember Crown Shard! +100 gold."
            shard = shard + 1
            relics.add "Ember Shard"
            hero.gold = hero.gold + 100
            hero.level = hero.level + 1
            hero.hp = 110
            print "You are now level " + hero.level
        }
    }
}
// ---------------- QUEST 8: Sandworm Hollow ----------------
if ending = "none" {
    print ""
    print "=================================="
    print "QUEST 8: Sandworm Hollow"
    print "=================================="
    print "The sand breathes. Then it OPENS — teeth first."
    print "SABLE: Worm! Spread out! Aim for the soft rings!"
    foeHp = 55
    repeat till foeHp <= 0 or hero.hp <= 0 {
        print "Sandworm HP: " + foeHp
        add input "Strike (1) or Potion (2)?"
        set output = move
        if move = "2" and potions > 0 {
            potions = potions - 1
            hero.hp = hero.hp + healAmt
            print "You quaff a potion."
        } else {
            hit = r from 9 to 16
            hit = hit + bonus
            foeHp = foeHp - hit
            print "You strike for " + hit
        }
        if foeHp > 0 {
            claw = r from 5 to 10
            hero.hp = hero.hp - claw
            print "The worm slams you for " + claw
        }
    }
    if hero.hp <= 0 {
        print "Worm food. The desert does not write epitaphs."
        print "ENDING: FALLEN on Quest 8."
        ending = "fallen"
    }
    if ending = "none" {
        print "The worm collapses into spice-scented rings. +90 gold."
        hero.gold = hero.gold + 90
    }
}

// ---------------- INTERLUDE 2: Campfire Stories ----------------
if ending = "none" {
    print ""
    print "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    print "Campfire: stories and stew"
    print "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    print "JUNO: Tell us of the old war, hero. Were you really there?"
    print "  1 = Tell the glorious version"
    print "  2 = Tell the honest version"
    add input "Glorious (1) or Honest (2)?"
    set output = choice
    if choice = "1" {
        print "You juggle three swords while narrating. The crew applauds."
        print "Morale soars. A scout joins you at dawn."
        allies = allies + 1
    } else {
        print "You tell of mud, fear, and friends lost."
        print "The fire burns lower. Everyone sits closer."
        allies = allies + 1
        potions = potions + 1
        print "SABLE presses a spare potion on you."
    }
    print "JUNO the scout officially joins your party!"
    party.add "Juno"
    print "Party members: " + party.length
    print "Full bellies, full HP. HP restored to 110."
    hero.hp = 110
}

// ---------------- QUEST 9: Frostfall Pass ----------------
if ending = "none" {
    print ""
    print "==============================="
    print "QUEST 9: Frostfall Pass"
    print "==============================="
    print "Snow like powdered glass. Something huge moves between drifts."
    print "YETI: GRAAAGH. (Translation: also battle.)"
    foeHp = 50
    repeat till foeHp <= 0 or hero.hp <= 0 {
        print "Yeti HP: " + foeHp
        add input "Strike (1) or Potion (2)?"
        set output = move
        if move = "2" and potions > 0 {
            potions = potions - 1
            hero.hp = hero.hp + healAmt
            print "You quaff a potion. It is nearly frozen. Still works."
        } else {
            hit = r from 9 to 16
            hit = hit + bonus
            foeHp = foeHp - hit
            print "You strike for " + hit
        }
        if foeHp > 0 {
            claw = r from 5 to 10
            hero.hp = hero.hp - claw
            print "Frozen fists pound you for " + claw
        }
    }
    if hero.hp <= 0 {
        print "A graceful ice statue marks the spot."
        print "ENDING: FALLEN on Quest 9."
        ending = "fallen"
    }
    if ending = "none" {
        print "The yeti bows — and shows you a hidden stair. +50 gold."
        hero.gold = hero.gold + 50
    }
}

// ---------------- QUEST 10: The Frozen Temple ----------------
if ending = "none" {
    print ""
    print "====================================="
    print "QUEST 10: The Frozen Temple"
    print "====================================="
    print "CARVED VOICE: None pass without answering."
    print "CARVED VOICE: I have cities, but no houses. Forests, but no trees."
    print "CARVED VOICE: Rivers without water. What am I? (lowercase)"
    add input "Answer:"
    set output = ans
    if ans = "map" or ans = "Map" {
        print "The ice doors sigh open. Inside: scrolls, soup, and 70 gold."
        print "One scroll shows every road you have walked, glowing faintly."
        print "You roll it up carefully. Best map you will ever own."
        hero.gold = hero.gold + 70
        hero.level = hero.level + 1
        print "You are now level " + hero.level
    } else {
        print "The doors stay shut. Your nose hairs freeze. You move on."
        hero.hp = hero.hp - 6
        print "Your HP: " + hero.hp
        if hero.hp <= 0 {
            print "Frozen mid-shiver. A cautionary tale."
            print "ENDING: FALLEN on Quest 10."
            ending = "fallen"
        }
    }
}
// ---------------- QUEST 11: Village of Embersnow ----------------
if ending = "none" {
    print ""
    print "=========================================="
    print "QUEST 11: Village of Embersnow"
    print "=========================================="
    print "Chimneys smoke against the white. ELDER SOVA meets you."
    print "SOVA: Our stores run thin. Will you share your rations?"
    print "Your gold: " + hero.gold
    print "  1 = Give 30 gold of food (kind)"
    print "  2 = Keep everything (practical)"
    add input "Share (1) or Keep (2)?"
    set output = choice
    if choice = "1" and hero.gold >= 30 {
        hero.gold = hero.gold - 30
        print "Children cheer around the stewpot. Two hunters join you."
        allies = allies + 2
    } else {
        if choice = "1" {
            print "You reach for coin you do not have. SOVA pretends not to notice."
        } else {
            print "You keep your packs. SOVA nods, understanding, but colder."
        }
        allies = allies + 1
        print "One old tracker joins you anyway."
    }
}

// ---------------- QUEST 12: Icewing Roost ----------------
if ending = "none" {
    print ""
    print "=================================="
    print "QUEST 12: Icewing Roost"
    print "=================================="
    print "The drake GLACIA guards the Frost Crown Shard."
    print "GLACIA: MORTAL. KNEEL OR BURN BLUE."
    foeHp = 70
    repeat till foeHp <= 0 or hero.hp <= 0 {
        print "Glacia HP: " + foeHp
        add input "Strike (1) or Potion (2)?"
        set output = move
        if move = "2" and potions > 0 {
            potions = potions - 1
            hero.hp = hero.hp + healAmt
            print "You quaff a potion."
        } else {
            hit = r from 10 to 17
            hit = hit + bonus
            foeHp = foeHp - hit
            print "You strike for " + hit
        }
        if foeHp > 0 {
            claw = r from 6 to 11
            hero.hp = hero.hp - claw
            print "Blue fire washes over you for " + claw
        }
    }
    if hero.hp <= 0 {
        print "Blue ice keeps you, prettily, forever."
        print "ENDING: FALLEN on Quest 12."
        ending = "fallen"
    }
    if ending = "none" {
        print "GLACIA folds one great wing. You have earned the question."
        print "  1 = Slay her (take hoard and shard)"
        print "  2 = Spare her (ask for the shard)"
        add input "Slay (1) or Spare (2)?"
        set output = choice
        if choice = "1" {
            print "The hoard smokes. 140 gold and the Frost Crown Shard."
            hero.gold = hero.gold + 140
            shard = shard + 1
            relics.add "Frost Shard"
        } else {
            print "GLACIA: ...No knight ever asked. Take it, little dawn."
            print "The Frost Crown Shard. And my oath for the last war."
            shard = shard + 1
            relics.add "Frost Shard"
            mercy = true
            allies = allies + 2
        }
        print "Crown Shards: " + shard
    }
}

// ---------------- INTERLUDE 3: Stargazing ----------------
if ending = "none" {
    print ""
    print "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    print "Interlude: the cracked moons"
    print "~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~"
    print "LUMINA's voice drifts down with the snow."
    print "LUMINA: See the cracks? That is where the Hollow leaks in."
    print "LUMINA: How many Crown Shards rest in your pack?"
    print "Shards: " + shard
    print "Relics carried: " + relics.length
    print "LUMINA: Good. Sleep. Tomorrow we fly."
    hero.hp = 120
    print "HP restored to 120."
}

// ---------------- QUEST 13: The Sky Docks ----------------
if ending = "none" {
    print ""
    print "==============================="
    print "QUEST 13: The Sky Docks"
    print "==============================="
    print "Harbor-master QUILL strokes his tariff board."
    print "QUILL: Passage to the Floating Isles. 60 gold. No haggling. ...Some haggling."
    print "QUILL: Fine! A story from the old war knocks off the dock fee!"
    print "You tell the one about the slime. QUILL pretends it is worth 60 gold."
    print "Your gold: " + hero.gold
    print "  1 = Pay 60 gold"
    print "  2 = Work the rigging (three hard days)"
    add input "Pay (1) or Work (2)?"
    set output = choice
    if choice = "1" and hero.gold >= 60 {
        hero.gold = hero.gold - 60
        print "You sail in comfort, eating grapes. Suspiciously good grapes."
    } else {
        if choice = "1" {
            print "Your purse is too light. QUILL grins: Rigging it is!"
        } else {
            print "You coil ropes till your hands sing."
        }
        repeat 3 {
            print "Day of hauling rope and scrubbing cloud-deck."
        }
        print "Passage earned. QUILL respects calluses."
        hero.hp = 120
    }
}
// ---------------- QUEST 14: Sky Pirates ----------------
if ending = "none" {
    print ""
    print "================================="
    print "QUEST 14: Sky Pirates"
    print "================================="
    print "Black sails! CAPTAIN VEXA swings aboard, grinning steel."
    print "VEXA: Your cargo or your eyebrows, hero!"
    foeHp = 60
    repeat till foeHp <= 0 or hero.hp <= 0 {
        print "Vexa HP: " + foeHp
        add input "Strike (1) or Potion (2)?"
        set output = move
        if move = "2" and potions > 0 {
            potions = potions - 1
            hero.hp = hero.hp + healAmt
            print "You quaff a potion."
        } else {
            hit = r from 10 to 17
            hit = hit + bonus
            foeHp = foeHp - hit
            print "You strike for " + hit
        }
        if foeHp > 0 {
            claw = r from 6 to 11
            hero.hp = hero.hp - claw
            print "Vexa's cutlass finds you for " + claw
        }
    }
    if hero.hp <= 0 {
        print "You fall through the clouds, eyebrows intact, hero not."
        print "ENDING: FALLEN on Quest 14."
        ending = "fallen"
    }
    if ending = "none" {
        print "VEXA yields, laughing: Keep the cargo! Keep the eyebrows!"
        print "VEXA: Any hero who fights fair at altitude earns my charts."
        print "VEXA: Storms ahead, darling. Mind the third wave — it bites."
        print "She pays 90 gold weregild and shares her storm charts."
        hero.gold = hero.gold + 90
        allies = allies + 1
    }
}

// ---------------- QUEST 15: The Storm Trial ----------------
