// ================= auth gate (on top) =================
users = []

gate = add a panel
gate.x = 0
gate.y = 0
gate.width = 780
gate.height = 660
gate.background = "#1E1E1E"

gateCard = add a panel to gate
gateCard.x = 180
gateCard.y = 110
gateCard.width = 420
gateCard.height = 420

gateTitle = add a text titled "Vexel MultiApp" to gateCard
gateTitle.x = 40
gateTitle.y = 25
gateTitle.width = 340
gateTitle.height = 50
gateTitle.font_size = 30
gateTitle.bold = true
gateTitle.alignment = "center"

gateSub = add a text titled "Sign in to open your apps" to gateCard
gateSub.x = 40
gateSub.y = 80
gateSub.width = 340
gateSub.height = 28
gateSub.alignment = "center"

gateUser = add an input box titled "Username..." to gateCard
gateUser.x = 40
gateUser.y = 125
gateUser.width = 340
gateUser.height = 45

gatePass = add an input box to gateCard
gatePass.x = 40
gatePass.y = 185
gatePass.width = 340
gatePass.height = 45
gatePass.password = true

gateGo = add a button titled "Unlock Apps" to gateCard
gateGo.x = 40
gateGo.y = 250
gateGo.width = 340
gateGo.height = 55
gateGo.font_size = 18
gateGo.background = "blue"
gateGo.text_color = "white"
gateGo.border_radius = 12

gateMsg = add an output box to gateCard
gateMsg.x = 40
gateMsg.y = 320
gateMsg.width = 340
gateMsg.height = 55

gateNew = add a button titled "No account? Sign up" to gateCard
gateNew.x = 40
gateNew.y = 385
gateNew.width = 165
gateNew.height = 35

gateHelp = add a button titled "Just look around" to gateCard
gateHelp.x = 215
gateHelp.y = 385
gateHelp.width = 165
gateHelp.height = 35

gateGo.on click {
    if gateUser.text = "" {
        gateMsg.text = "Enter your username."
    } else if gatePass.text = "" {
        gateMsg.text = "Enter your password."
    } else {
        try {
            db = json read "accounts.json"
            users = db.users
        } error {
            users = []
        }
        if length of users = 0 {
            gateMsg.text = "No accounts yet. Sign up first!"
        } else {
            found = false
            i = 0
            repeat till i = length of users {
                u = users[i]
                if u.name = gateUser.text and u.pass = gatePass.text {
                    found = true
                }
                i = i + 1
            }
            if found {
                gate.hide
            } else {
                gateMsg.text = "Wrong details. Try again."
            }
        }
    }
}

gateNew.on click {
    if gateUser.text = "" {
        gateMsg.text = "Type a username first."
    } else if gatePass.text = "" {
        gateMsg.text = "Type a password first."
    } else {
        try {
            db2 = json read "accounts.json"
            users = db2.users
        } error {
            users = []
        }
        taken = false
        j = 0
        repeat till j = length of users {
            u2 = users[j]
            if u2.name = gateUser.text {
                taken = true
            }
            j = j + 1
        }
        if taken {
            gateMsg.text = "Name taken. Opening anyway!"
            gate.hide
        } else {
            newUser = {
                name = gateUser.text
                pass = gatePass.text
            }
            users.add newUser
            save = {
                users = users
            }
            json write save to "accounts.json"
            gate.hide
        }
    }
}

gateHelp.on click {
    gate.hide
}

window.show
