// ================= app 1: calculator =================
pageCalc = add a panel
pageCalc.x = 12
pageCalc.y = 52
pageCalc.width = 756
pageCalc.height = 540

calcDisplay = add an output box to pageCalc
calcDisplay.x = 20
calcDisplay.y = 15
calcDisplay.width = 420
calcDisplay.height = 60
calcDisplay.font_size = 22

b1 = add a button titled "1" to pageCalc
b1.x = 20
b1.y = 90
b1.width = 130
b1.height = 60

b2 = add a button titled "2" to pageCalc
b2.x = 160
b2.y = 90
b2.width = 130
b2.height = 60

b3 = add a button titled "3" to pageCalc
b3.x = 300
b3.y = 90
b3.width = 130
b3.height = 60

bPlus = add a button titled "+" to pageCalc
bPlus.x = 20
bPlus.y = 160
bPlus.width = 130
bPlus.height = 60

bEq = add a button titled "=" to pageCalc
bEq.x = 160
bEq.y = 160
bEq.width = 130
bEq.height = 60
bEq.background = "blue"
bEq.text_color = "white"

bClr = add a button titled "C" to pageCalc
bClr.x = 300
bClr.y = 160
bClr.width = 130
bClr.height = 60
bClr.background = "red"
bClr.text_color = "white"

current = ""
first = ""
op = ""

b1.on click {
    current = current + "1"
    calcDisplay.text = current
}

b2.on click {
    current = current + "2"
    calcDisplay.text = current
}

b3.on click {
    current = current + "3"
    calcDisplay.text = current
}

bPlus.on click {
    first = current
    op = "+"
    current = ""
    calcDisplay.text = ""
}

bEq.on click {
    second = calcDisplay.text
    try {
        f = number of first
        s = number of second
        if op = "+" {
            result = f + s
        } else {
            result = s
        }
        calcDisplay.text = result
        current = calcDisplay.text
    } error {
        calcDisplay.text = error.message
    }
}

bClr.on click {
    calcDisplay.text = ""
    first = ""
    op = ""
    current = ""
}

// ================= app 2: notes =================
pageNotes = add a panel
pageNotes.x = 12
pageNotes.y = 52
pageNotes.width = 756
pageNotes.height = 540
pageNotes.hide

noteInput = add an input box titled "New note..." to pageNotes
noteInput.x = 20
noteInput.y = 15
noteInput.width = 440
noteInput.height = 42

addNoteBtn = add a button titled "Add" to pageNotes
addNoteBtn.x = 470
addNoteBtn.y = 15
addNoteBtn.width = 120
addNoteBtn.height = 42
addNoteBtn.background = "green"
addNoteBtn.text_color = "white"

noteList = add a list to pageNotes
noteList.x = 20
noteList.y = 70
noteList.width = 570
noteList.height = 330

noteCount = add a text titled "0 notes" to pageNotes
noteCount.x = 20
noteCount.y = 415
noteCount.width = 280
noteCount.height = 30

clearNotesBtn = add a button titled "Clear" to pageNotes
clearNotesBtn.x = 320
clearNotesBtn.y = 415
clearNotesBtn.width = 270
clearNotesBtn.height = 40

notesTotal = 0

addNoteBtn.on click {
    if noteInput.text = "" {
        noteCount.text = "Type a note first!"
    } else {
        noteList.add noteInput.text
        notesTotal = notesTotal + 1
        noteCount.text = "Notes: " + notesTotal
        noteInput.text = ""
    }
}

clearNotesBtn.on click {
    noteList.clear
    notesTotal = 0
    noteCount.text = "0 notes"
}

// ================= app 3: dice =================
pageDice = add a panel
pageDice.x = 12
pageDice.y = 52
pageDice.width = 756
pageDice.height = 540
pageDice.hide

diceTitle = add a text titled "Roll the dice!" to pageDice
diceTitle.x = 20
diceTitle.y = 15
diceTitle.width = 550
diceTitle.height = 45
diceTitle.font_size = 26
diceTitle.bold = true

rollBtn = add a button titled "Roll D6" to pageDice
rollBtn.x = 20
rollBtn.y = 75
rollBtn.width = 270
rollBtn.height = 65
rollBtn.font_size = 18

roll20Btn = add a button titled "Roll D20" to pageDice
roll20Btn.x = 320
roll20Btn.y = 75
roll20Btn.width = 270
roll20Btn.height = 65
roll20Btn.font_size = 18

diceOut = add an output box to pageDice
diceOut.x = 20
diceOut.y = 160
diceOut.width = 570
diceOut.height = 150
diceOut.text = "No rolls yet."

rollBtn.on click {
    roll = r from 1 to 6
    diceOut.text = "D6: " + roll
}

roll20Btn.on click {
    big = r from 1 to 20
    if big = 20 {
        diceOut.text = "D20: 20 CRITICAL!"
    } else {
        diceOut.text = "D20: " + big
    }
}

// ================= app 4: stopwatch =================
pageTimer = add a panel
pageTimer.x = 12
pageTimer.y = 52
pageTimer.width = 756
pageTimer.height = 540
pageTimer.hide

watchLabel = add a text titled "0s" to pageTimer
watchLabel.x = 20
watchLabel.y = 15
watchLabel.width = 570
watchLabel.height = 90
watchLabel.font_size = 52
watchLabel.bold = true
watchLabel.alignment = "center"

startBtn = add a button titled "Start" to pageTimer
startBtn.x = 20
startBtn.y = 125
startBtn.width = 280
startBtn.height = 60
startBtn.background = "green"
startBtn.text_color = "white"

stopBtn = add a button titled "Stop" to pageTimer
stopBtn.x = 310
stopBtn.y = 125
stopBtn.width = 280
stopBtn.height = 60
stopBtn.background = "red"
stopBtn.text_color = "white"

resetBtn = add a button titled "Reset" to pageTimer
resetBtn.x = 20
resetBtn.y = 200
resetBtn.width = 570
resetBtn.height = 55

secs = 0
ticking = false

ticker = every 1 second {
    if ticking {
        secs = secs + 1
        watchLabel.text = "" + secs + "s"
    }
}

startBtn.on click {
    ticking = true
}

stopBtn.on click {
    ticking = false
}

resetBtn.on click {
    secs = 0
    ticking = false
    watchLabel.text = "0s"
}

// ================= app 5: counter =================
pageCount = add a panel
pageCount.x = 12
pageCount.y = 52
pageCount.width = 756
pageCount.height = 540
pageCount.hide

countLabel = add a text titled "0" to pageCount
countLabel.x = 20
countLabel.y = 15
countLabel.width = 570
countLabel.height = 90
countLabel.font_size = 52
countLabel.bold = true
countLabel.alignment = "center"

plusOne = add a button titled "+1" to pageCount
plusOne.x = 20
plusOne.y = 125
plusOne.width = 180
plusOne.height = 60
plusOne.font_size = 20

minusOne = add a button titled "-1" to pageCount
minusOne.x = 215
minusOne.y = 125
minusOne.width = 180
minusOne.height = 60
minusOne.font_size = 20

zeroOne = add a button titled "Reset" to pageCount
zeroOne.x = 410
zeroOne.y = 125
zeroOne.width = 180
zeroOne.height = 60

clicks = 0

plusOne.on click {
    clicks = clicks + 1
    countLabel.text = "" + clicks
}

minusOne.on click {
    clicks = clicks - 1
