}

// ================= app 6: unit converter =================
pageUnits = add a panel
pageUnits.x = 12
pageUnits.y = 52
pageUnits.width = 756
pageUnits.height = 540
pageUnits.hide

unitsTitle = add a text titled "cm to inches" to pageUnits
unitsTitle.x = 20
unitsTitle.y = 15
unitsTitle.width = 550
unitsTitle.height = 45
unitsTitle.font_size = 26
unitsTitle.bold = true

cmInput = add an input box titled "Centimeters..." to pageUnits
cmInput.x = 20
cmInput.y = 75
cmInput.width = 350
cmInput.height = 45

convBtn = add a button titled "Convert" to pageUnits
convBtn.x = 385
convBtn.y = 75
convBtn.width = 205
convBtn.height = 45
convBtn.background = "blue"
convBtn.text_color = "white"

unitsOut = add an output box to pageUnits
unitsOut.x = 20
unitsOut.y = 140
unitsOut.width = 570
unitsOut.height = 90
unitsOut.text = "Type a number and convert."

convBtn.on click {
    try {
        cm = number of cmInput.text
        inches = cm / 2.54
        unitsOut.text = cmInput.text + " cm = " + inches + " in"
    } error {
        unitsOut.text = "That is not a number."
    }
}

// ================= app 7: password generator =================
pagePass = add a panel
pagePass.x = 12
pagePass.y = 52
pagePass.width = 756
pagePass.height = 540
pagePass.hide

passTitle = add a text titled "Password generator" to pagePass
passTitle.x = 20
passTitle.y = 15
passTitle.width = 550
passTitle.height = 45
passTitle.font_size = 26
passTitle.bold = true

genBtn = add a button titled "Generate" to pagePass
genBtn.x = 20
genBtn.y = 75
genBtn.width = 250
genBtn.height = 55
genBtn.font_size = 18
genBtn.background = "green"
genBtn.text_color = "white"

passOut = add an output box to pagePass
passOut.x = 20
passOut.y = 150
passOut.width = 570
passOut.height = 90
passOut.font_size = 20
passOut.text = "Press Generate."

chars = "abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789!?#"
top = length of chars - 1

genBtn.on click {
    pw = ""
    repeat 12 {
        idx = r from 0 to top
        pw = pw + [idx] from chars
    }
    passOut.text = pw
}

// ================= app 8: grade checker =================
pageGrade = add a panel
pageGrade.x = 12
pageGrade.y = 52
pageGrade.width = 756
pageGrade.height = 540
pageGrade.hide

gradeTitle = add a text titled "Grade checker" to pageGrade
gradeTitle.x = 20
gradeTitle.y = 15
gradeTitle.width = 550
gradeTitle.height = 45
gradeTitle.font_size = 26
gradeTitle.bold = true

scoreInput = add an input box titled "Score 0-100..." to pageGrade
scoreInput.x = 20
scoreInput.y = 75
scoreInput.width = 350
scoreInput.height = 45

gradeBtn = add a button titled "Grade" to pageGrade
gradeBtn.x = 385
gradeBtn.y = 75
gradeBtn.width = 205
gradeBtn.height = 45
gradeBtn.background = "blue"
gradeBtn.text_color = "white"

gradeOut = add an output box to pageGrade
gradeOut.x = 20
gradeOut.y = 140
gradeOut.width = 570
gradeOut.height = 90
gradeOut.text = "Type a score and grade it."

gradeBtn.on click {
    try {
        score = number of scoreInput.text
        if score >= 90 {
            gradeOut.text = "A - excellent!"
        } else if score >= 80 {
            gradeOut.text = "B - good!"
        } else if score >= 70 {
            gradeOut.text = "C - okay."
        } else if score >= 60 {
            gradeOut.text = "D - pass."
        } else {
            gradeOut.text = "F - try again."
        }
    } error {
        gradeOut.text = "That is not a number."
    }
}

