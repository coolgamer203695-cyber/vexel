tabCount.y = 8
tabCount.width = 70
tabCount.height = 34

tabUnits = add a button titled "Units"
tabUnits.x = 377
tabUnits.y = 8
tabUnits.width = 70
tabUnits.height = 34

tabPass = add a button titled "Pass"
tabPass.x = 450
tabPass.y = 8
tabPass.width = 70
tabPass.height = 34

tabGrade = add a button titled "Grade"
tabGrade.x = 523
tabGrade.y = 8
